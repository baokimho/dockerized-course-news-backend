# Example environment variables for local development
# Copy to .env and customize before running locally

# MongoDB connection used by the app (Compose uses mongodb://mongo:27017/...) 
MONGO_URI=mongodb://127.0.0.1:27017/baokim_dev

# Session secret for express-session (set a strong value for real projects)
SESSION_SECRET=change_this_to_a_strong_secret

# App port
PORT=3000
APP_PORT=3000

# Node environment
NODE_ENV=development

# Docker Compose override for the app container database URI.
# Leave unset for the default Compose MongoDB service:
# mongodb://mongo:27017/baokim_prod
# APP_MONGO_URI=

# Auto seeding options (for local/demo only)
# AUTO_SEED: enable automatic seed on DB connect
# SEED_DEMO_CONTENT: also insert sample courses/news
# SEED_ADMIN_RESET_PASSWORD: if true, reset seeded admin password even if user exists
AUTO_SEED=true
SEED_DEMO_CONTENT=true
SEED_ADMIN_NAME=Demo Admin
SEED_ADMIN_EMAIL=admin@demo.local
SEED_ADMIN_PASSWORD=Admin123
SEED_ADMIN_RESET_PASSWORD=false

# SMTP settings (optional)
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# MAIL_FROM="CourseSub <no-reply@example.com>"
